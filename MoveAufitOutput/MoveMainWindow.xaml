<Window x:Class="MoveAufitOutput.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoveAufitOutput"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>            
			<RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Width="100" Content="Source Directory" Click="sourceDirClick"/>
            <TextBox Name="tbSource" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Button Width="100" Content="Dest. Directory" Click="destDirClick"/>
            <TextBox Name="tbDest" BorderThickness="0" VerticalContentAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="2" >
            <TextBox Name="tbResult" BorderThickness="1" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" Margin="2" FontFamily="Consolas" FontSize="15" Grid.ColumnSpan="3" />
        </Grid>

        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0" Text="Total" BorderThickness="0" Margin="2" VerticalAlignment="Center"/>
            <TextBox  Grid.Column="1" Name="tbTotal" Text="0" BorderThickness="0" Margin="2" Width="30" VerticalAlignment="Center"/>
            <TextBox  Grid.Column="2" Text="Done" BorderThickness="0" Margin="2" VerticalAlignment="Center"/>
            <TextBox  Grid.Column="3" Name="tbDone" Text="0" BorderThickness="0" Margin="2" Width="30" VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="4" Name="pbProgress" Height="20"/>
            <Button Grid.Column="5" Margin="5" Content="Scan" Click="btScanClicked" Width="80" HorizontalAlignment="Right"/>
            <Button Grid.Column="6" Margin="5" Content="Move" Click="btMoveClicked" Width="80" />
            <Button Grid.Column="7" Margin="5" Content="Stop" Click="btStopClicked" Width="80" />
        </Grid>


    </Grid>
</Window>
