<Window x:Class="BatchAufit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufit Batch Runner" Height="400" Width="900">
    <Grid Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Root Directory" Click="RootDirectoryClicked" Height="20" Padding="5,0,5,0" Margin="5" />
            <TextBox Grid.Column="1" Name="tbRootDirName" BorderThickness="0" Background="Transparent" Margin="5,5,0,0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0" Name="tbAction" Text="Action" BorderThickness="0" Margin="2" Width="100"/>
            <ProgressBar Name="pbProgress" Grid.Column="1" Visibility="Hidden" IsIndeterminate="True" />
            <TextBox  Grid.Column="2" Text="Total" BorderThickness="0" Margin="2" />
            <TextBox  Grid.Column="3" Name="tbTotal" Text="0" BorderThickness="0" Margin="2" Width="50"/>
            <TextBox  Grid.Column="4" Text="Done" BorderThickness="0" Margin="2" />
            <TextBox  Grid.Column="5" Name="tbDone" Text="0" BorderThickness="0" Margin="2" Width="50"/>
        </Grid>

        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352*"/>
                <ColumnDefinition Width="28*"/>
                <ColumnDefinition Width="137*"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="tbResult" BorderThickness="1" VerticalScrollBarVisibility="Auto" Margin="2" FontFamily="Consolas" FontSize="15" Grid.ColumnSpan="3" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" >
            <CheckBox x:Name="cbDiskView" Content="Disk View" Margin="2" IsChecked="True" Padding="2,0,5,0"/>
            <CheckBox x:Name="cbProt" Content="Protections" Margin="2" IsChecked="True" Padding="2,0,5,0"/>
            <CheckBox x:Name="cbSave" Content="Save Image" Margin="2" IsChecked="True" Padding="2,0,5,0"/>
            <TextBox BorderThickness="0" Margin="2" Text="Suffix:" IsReadOnly="True"/>
            <TextBox Name="tbSuffix"  Text="aufit_0.9" BorderThickness="0" VerticalContentAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="4" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Margin="5" Content="Start" Click="btStartClicked" Width="80" HorizontalAlignment="Right"/>
            <Button Grid.Column="2" Margin="5" Content="Stop" Click="btStopClicked" Width="80" />
            <Button Grid.Column="3" Margin="5" Content="Clean All" Click="btCleanClick" Width="80" />
        </Grid>
    </Grid>

</Window>
