<Window x:Class="BatchAufit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufit Batch Runner" Height="600" Width="900">
    <Grid Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Root Directory" Click="RootDirectoryClicked" Height="20" Padding="5,0,5,0" Margin="5" />
            <Button Grid.Column="1" Content="Reload" Click="ReloadClicked" Height="20" Padding="5,0,5,0" Margin="5" />
            <TextBox Grid.Column="2" Name="tbRootDirName" BorderThickness="0" Background="Transparent" Margin="5,5,0,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="3" Content="Save Log" Click="SaveLogClicked" Height="20" Padding="5,0,5,0" Margin="5" />
            <Button Grid.Column="4" Margin="0" Click="updateClicked" BorderThickness="0" >
                <Image Source="update.png"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" >
            <TextBox Name="tbResult" BorderThickness="1" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" Margin="2" FontFamily="Consolas" FontSize="15" Grid.ColumnSpan="3" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" >
            <CheckBox x:Name="cbDiskView" Content="Disk View" Margin="2" IsChecked="True" Padding="2,0,5,0"/>
            <CheckBox x:Name="cbProt" Content="Protections" Margin="2" IsChecked="True" Padding="2,0,5,0"/>
            <CheckBox x:Name="cbSave" Content="Save:" Margin="2" IsChecked="True" Padding="2,0,0,0"/>
            <TextBox BorderThickness="0" Margin="2" Text="stx" IsReadOnly="True" Padding="2,0,5,0"/>
            <TextBox BorderThickness="0" Margin="2" Text="Suffix:" IsReadOnly="True"/>
            <TextBox Name="tbSuffix"  Text="aufit.1.4" BorderThickness="0" VerticalContentAlignment="Center" Padding="0,0,5,0"/>
            <TextBox BorderThickness="0" Margin="2" Text="Scale:" IsReadOnly="True"/>
            <TextBox Name="tbScale"  Text="1.4" BorderThickness="0" VerticalContentAlignment="Center" Padding="0,0,5,0" Height="20" VerticalAlignment="Top"/>
            <TextBox BorderThickness="0" Margin="2" Text="MaxProcessTime:" IsReadOnly="True" />
            <TextBox Name="tbMaxProcessTime"  BorderThickness="1" VerticalContentAlignment="Center" Padding="0,0,5,0" TextChanged="MaxProcessTimeChanged"/>
        </StackPanel>

        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0" Text="Total" BorderThickness="0" Margin="2" VerticalAlignment="Center"/>
            <TextBox  Grid.Column="1" Name="tbTotal" Text="0" BorderThickness="0" Margin="2" Width="30" VerticalAlignment="Center"/>
            <TextBox  Grid.Column="2" Text="Done" BorderThickness="0" Margin="2" VerticalAlignment="Center"/>
            <TextBox  Grid.Column="3" Name="tbDone" Text="0" BorderThickness="0" Margin="2" Width="30" VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="4" Name="pbProgress" Height="20"/>
            <Button Grid.Column="5" Margin="5" Content="Start" Click="btStartClicked" Width="80" HorizontalAlignment="Right"/>
            <Button Grid.Column="6" Margin="5" Content="Stop" Click="btStopClicked" Width="80" />
            <Button Grid.Column="7" Margin="5" Content="Clean All" Click="btCleanClick" Width="80" />
            <Button Grid.Column="8" Margin="5" Content="Exit" Click="btExitClick" Width="80" />
        </Grid>
    </Grid>

</Window>
