<Window x:Class="Aufit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="800" Width="1100" Closing="mainWinClosing" AllowDrop="True" Drop="fileDrop">
    <Grid Name="mainGrid" KeyDown="keyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Name="gridCommand">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>            
            <Button Grid.Column="0" x:Name="btFile" Content="Load image" Click="openFileClick" Height="20" VerticalAlignment="Top" Margin="5,5,0,0" />
            <TextBox Grid.Column="1" Name="tbFileName" BorderThickness="0" Background="Transparent" Margin="5,5,0,0" />
			<TextBox Grid.Column="2" Name="tbRevolution" BorderThickness="0" Text="Rev. */*" Height="18" TextAlignment="Center" 
				HorizontalAlignment="Right" Background="Transparent" />
			<Button Grid.Column="3" Margin="5,0,0,0" Height="18" Width="18" BorderThickness="0" Background="{x:Null}" Click="minusRevClicked">
				<Image Source="Resources/minus.png"/>
			</Button>
			<Button Grid.Column="4" Margin="5,0,0,0" Height="18" Width="18" Click="plusRevClicked" BorderThickness="0" Background="{x:Null}" >
				<Image Source="Resources/plus.png"/>
			</Button>
			<CheckBox Grid.Column="5" x:Name="cbLimitFlux" Content="Limit Flux" Margin="15,0,10,0" VerticalAlignment="Center" 
				Click="cbLimitClick" FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="True" />
			<Button Grid.Column="6" Name="btSave" Height="20" Margin="0,5,5,0"  Content="Save Pict" Width="60"  Click="btSavePictClick"/>
        </Grid>

        <Grid Grid.Row="1" Name="matrixGrid" Margin="5" Loaded="matrixGridLoaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Canvas Grid.Column="0" Name="BM1" />
            <Canvas Grid.Column="1" Name="BM2" />
            <TabControl  Grid.Column="2" x:Name="tabCtrl" Background="Transparent">
                <TabItem Header="Histogram" Background="Transparent">
                    <Grid Margin="0,0,0,0" x:Name ="histoGrid"  ClipToBounds="True" Background="Transparent" SizeChanged="histoGridSizeChanged">
                        <Canvas Margin="2" Name="cvTextHisto" ClipToBounds="True" Background="Transparent">
                            <Canvas Name="cvGraphicHisto" ClipToBounds="True" Background="Transparent" />
                        </Canvas>
                        <CheckBox x:Name="cbHistoLog" Grid.Column="2" Content="Logarithmic Scale" Margin="0,15,20,0" VerticalAlignment="Top" 
                      Click="cbHistoLogClick" FlowDirection="RightToLeft" HorizontalAlignment="Right" />
                    </Grid>
                </TabItem>
                <TabItem Header="Information" Background="Transparent">
                    <Grid>
                        <TextBox Name="infoBox" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent"/>
                        <Button Name="btInfSave" Click="infoSaveClick" Content="Save" Width="40" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,20,3"></Button>
                        <Button Name="btInfClear" Click="infoClearClick" Content="Clear" Width="40" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,60,3"></Button>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

		<Grid Grid.Row="2" Margin="5" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
			<ProgressBar Grid.Column="0" Name="progress" Visibility="Hidden" IsIndeterminate="True" Width="100"/>
			<TextBox Grid.Column="1" BorderThickness="0" Name="tbStatus" FontWeight="Bold" FontSize="14" Visibility="Visible" Margin="10,0,0,0" />
			<TextBox Grid.Column="2" Margin="10,0,0,0" Name="tbVersion" Text="Version" BorderThickness="0"  Background="Transparent" />
		</Grid>

        <TabControl  Grid.Row="2" x:Name="tabDisplay" Background="Transparent" Margin="5" SelectionChanged="tabDisplaySelectionChanged">
			<TabItem x:Name="tabItemTrack" Header="Track View" Background="Transparent"  Width="100" HorizontalAlignment="Left">
				<Grid Grid.Row="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="3*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="10,10,10,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="auto"/>
							<ColumnDefinition Width="auto"/>
							<ColumnDefinition Width="auto"/>
							<ColumnDefinition Width="auto"/>
							<ColumnDefinition Width="auto"/>
							<ColumnDefinition Width="auto"/>
							<ColumnDefinition Width="auto"/>
						</Grid.ColumnDefinitions>
						<TextBox Grid.Column="0" x:Name="tbFluxInfo" FontFamily="Arial" FontSize="13" Foreground="DarkBlue" FontWeight="Bold" Width="auto" Height="18" BorderThickness="0" Background="Transparent"/>
						
						<CheckBox Grid.Column="1" x:Name="cbDetail" Content="Detail" Margin="10,0,10,0" VerticalAlignment="Center" Click="cbDetailClick"
							  FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="True" />
					</Grid>

					<Grid Grid.Row="1" Margin="10,0,10,0"  x:Name ="fluxGrid"  ClipToBounds="False" Background="Transparent" SizeChanged="fluxGridSizeChanged" >
						<Canvas Margin="2" Name="cvTextFlux" ClipToBounds="True" Grid.ColumnSpan="2">
							<Canvas Name="cvGraphicFlux" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="fluxMouseLBD" MouseWheel="fluxMouseWheel" 
									MouseLeftButtonUp="fluxMouseLBU" MouseMove="fluxMouseMove" MouseRightButtonDown="fluxMouseRBDown"/>
						</Canvas>
						<StackPanel Grid.Column="5" Margin="10,20,15,0" Orientation="Horizontal" HorizontalAlignment="Right">
							<CheckBox Grid.Column="8" x:Name="cbA1" Content="A1" Margin="5,0,5,0" VerticalAlignment="Top" 
								FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="True" />
							<CheckBox Grid.Column="9" x:Name="cbC2" Content="C2" Margin="5,0,5,0" VerticalAlignment="Top" Click="cbDetailClick"
								FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="False" />
						</StackPanel>
					</Grid>
        
					<GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
					<Grid Grid.Row="2" Margin="10,0,10,0"  x:Name ="clockGrid"  ClipToBounds="False" SizeChanged="clockGridSizeChanged" >
						<Canvas Margin="2" x:Name="cvTextClock" ClipToBounds="True">
							<Canvas x:Name="cvGraphicClock" ClipToBounds="True" />
						</Canvas>
					</Grid>

					<Grid Grid.Row="3" Margin="10,0,10,0"  x:Name ="dataGrid"  ClipToBounds="False" Background="Transparent" SizeChanged="dataGridSizeChanged" >
						<Canvas Margin="2" Name="cvTextData" ClipToBounds="True">
							<Canvas Name="cvGraphicData" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="dataMouseLBD" />
						</Canvas>
					</Grid>


				</Grid>
			</TabItem>
            
			<TabItem x:Name="tabItemDisk" Header="Disk View" Width="100">
                <Grid Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="DarkSlateGray" Name="gridDisk">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0"   Stretch="Uniform">
                            <Grid Name="cvDisk0" Margin="0" />
                        </Viewbox>
                        <Viewbox Grid.Column="1" Stretch="Uniform" >
                            <Grid Name="cvDisk1" Margin="0" />
                        </Viewbox>
                    </Grid>
                    
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save Picture" Width="80" Margin="2" VerticalContentAlignment="Center" Click="saveImageClick"/>
                        <TextBox Grid.Column="1" Text="Resolution: " BorderThickness="0" VerticalContentAlignment="Center"/>
                        <RadioButton Grid.Column="2" Name="rbHigh" Content="High" Margin="0,0,7,0" VerticalContentAlignment="Center" FlowDirection="RightToLeft"/>
                        <RadioButton Grid.Column="3" Name="rbMed" Content="Med" IsChecked="True"  Margin="0,0,7,0" VerticalContentAlignment="Center" FlowDirection="RightToLeft"/>
                        <RadioButton Grid.Column="4" Name="rbLow" Content="Low" Margin="0,0,7,0" VerticalContentAlignment="Center" FlowDirection="RightToLeft"/>
                        <CheckBox Grid.Column="5" x:Name="cbOutOfBand" Content="Out of Band" Margin="20,0,10,0" VerticalAlignment="Center" 
				            FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="True" Click="btDiskRefresh" />
                        <CheckBox Grid.Column="6" x:Name="cbDiskNFA" Content="Unf. NFA" Margin="15,0,10,0" VerticalAlignment="Center" 
				            FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="False" Click="btDiskRefresh"/>
                        <Button Grid.Column="7" Name="btDisk" Margin="10,2,0,2"  Content="Refresh" Width="80"  Click="btDiskRefresh" VerticalContentAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem x:Name="tabItemContent" Header="Content" Width="100">
                <StackPanel>
                    <Button  Name="btTrack" Margin="0,0,10,0"  Content="Track Buffer" Width="100" Click="btTrackWindowClick" HorizontalAlignment="Left"/>
                    <Button  Name="btSector" Margin="0,0,10,0"  Content="Sectors Buffer" Width="100" Click="btSectorWindowClick" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="tabItemAnalysis" Header="Analysis" Width="100">
                <Grid Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <TextBox BorderThickness="0" VerticalScrollBarVisibility="Auto" Margin="2" Name="tbAnalysis" FontFamily="Consolas" FontSize="12" />
                        <Button Name="btAnaSave" Click="anaSaveClick" Content="Save" Width="40" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,20,3"></Button>
                        <Button Name="btAnaClear" Click="anaClearClick" Content="Clear" Width="40" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,60,3"></Button>

                    </Grid>

                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="4" Name="btProt" Margin="0,0,10,0"  Content="Protections" Width="100" 
                                Click="btProtectionClick" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
			</TabItem>
            
			<TabItem x:Name="tabItemSave" Header="Save Image" Width="100">
                <Grid Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <TextBox BorderThickness="0" VerticalScrollBarVisibility="Auto" Margin="5" Name="tbSaveImage" FontFamily="Consolas" FontSize="12" />
                    </Grid>

                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Output Format:" VerticalContentAlignment="Center"/>
                        <ComboBox Grid.Column="1" Margin="5" Name="cbOutputFormat">
                            <ComboBoxItem IsSelected="True">STX</ComboBoxItem>
                            <ComboBoxItem>ST</ComboBoxItem>
                            <ComboBoxItem>MSA</ComboBoxItem>
                            <ComboBoxItem>DIM</ComboBoxItem>
                        </ComboBox>
                        <CheckBox Grid.Column="4" x:Name="cbForceDS" Content="Force DS" Margin="10,0,10,0" VerticalAlignment="Center" 
							  FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="False" />
                         <Button Grid.Column="5" Name="btWrite" Margin="10,5,10,5"  Content="Write Image" Width="100"  Click="btWriteDiskClick" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>                
			</TabItem>
		</TabControl>
	</Grid>
</Window>
