<Window x:Class="Aufit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="750" Width="1200" Closing="mainWinClosing" AllowDrop="True" Drop="fileDrop">
    <Grid Name="mainGrid" KeyDown="keyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="3*" MinHeight="80"/>
            <RowDefinition Height="1*" MinHeight="50"/>
            <RowDefinition Height="1*" />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            
            <Button Grid.Column="0" x:Name="btFile" Content="Load image" Click="openFileClick" Height="20" VerticalAlignment="Top" />
            <TextBox Grid.Column="1" Name="tbFileName" BorderThickness="0" Margin="5,0" Background="Transparent"/>
            <CheckBox Grid.Column="6" x:Name="cbLimitFlux" Content="Limit Flux" Margin="10,0,10,0" VerticalAlignment="Center" 
                      Click="cbLimitClick" FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="True" />
            <CheckBox Grid.Column="7" x:Name="cbForceDS" Content="Force DS" Margin="10,0,10,0" VerticalAlignment="Center" 
                      Click="cbRecoverClick" FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="False" />
            <CheckBox Grid.Column="8" x:Name="cbDetail" Content="Detail" Margin="10,0,10,0" VerticalAlignment="Center" Click="cbDetailClick"
                      FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="False" />
        </Grid>

        <Grid Grid.Row="1" Name="matrixGrid" Margin="10,10,10,10" Loaded="matrixGridLoaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Canvas Grid.Column="0" Name="BM1" ></Canvas>
            <Canvas Grid.Column="1" Name="BM2" />
            <TabControl  Grid.Column="2" x:Name="tabCtrl" Background="Transparent">
                <TabItem Header="Histogram" Background="Transparent">
                    <Grid Margin="0,0,0,0" x:Name ="histoGrid"  ClipToBounds="True" Background="Transparent" SizeChanged="histoGridSizeChanged">
                        <Canvas Margin="2" Name="cvTextHisto" ClipToBounds="True" Background="Transparent">
                            <Canvas Name="cvGraphicHisto" ClipToBounds="True" Background="Transparent" />
                        </Canvas>
                        <CheckBox x:Name="cbHistoLog" Grid.Column="2" Content="Logarithmic Scale" Margin="0,15,20,0" VerticalAlignment="Top" 
                      Click="cbHistoLogClick" FlowDirection="RightToLeft" HorizontalAlignment="Right" />
                    </Grid>
                </TabItem>
                <TabItem Header="Information">
                    <TextBox Name="infoBox" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="2" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="tbFluxInfo" FontFamily="Arial" FontSize="13" Foreground="DarkBlue" FontWeight="Bold" Width="auto" Height="18" BorderThickness="0" Background="Transparent"/>
            <TextBox Grid.Column="1" Text="Rev" Margin="5,0" BorderThickness="0" Height="20" TextAlignment="Center" HorizontalAlignment="Right" Background="Transparent"/>
            <Button Grid.Column="2" Margin="0" Height="18" Width="18" BorderThickness="0" Background="{x:Null}" Click="minusRevClicked">
                <Image Source="Ressources/minus.png"/>
            </Button>
            <TextBox Grid.Column="3" Name="revolution" BorderThickness="0" Text="1" Height="18" Width="18" TextAlignment="Center" HorizontalAlignment="Right" Background="Transparent"/>
            <Button Grid.Column="4" Margin="0" Height="18" Width="18" Click="plusRevClicked" BorderThickness="0" Background="{x:Null}" >
                <Image Source="Ressources/plus.png"/>
            </Button>
            <!--<Border Grid.Column="1" Grid.ColumnSpan="4" BorderThickness="1" Margin="-2" BorderBrush="Black"></Border>-->
        </Grid>

        <Grid Grid.Row="3" Margin="10,0,10,0"  x:Name ="fluxGrid"  ClipToBounds="False" Background="Transparent" SizeChanged="fluxGridSizeChanged" >
            <Canvas Margin="2" Name="cvTextFlux" ClipToBounds="True" Grid.ColumnSpan="2">
                <Canvas Name="cvGraphicFlux" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="fluxMouseLBD" MouseWheel="fluxMouseWheel" 
                            MouseLeftButtonUp="fluxMouseLBU" MouseMove="fluxMouseMove" MouseRightButtonDown="fluxMouseRBDown"/>
            </Canvas>
            <StackPanel Grid.Column="5" Margin="10,20,15,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Grid.Column="8" x:Name="cbA1" Content="A1" Margin="5,0,5,0" VerticalAlignment="Top" 
                      FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="True" />
                <CheckBox Grid.Column="9" x:Name="cbC2" Content="C2" Margin="5,0,5,0" VerticalAlignment="Top" Click="cbDetailClick"
                      FlowDirection="RightToLeft" HorizontalAlignment="Right" IsChecked="False" />
            </StackPanel>
        </Grid>
        
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        <Grid Grid.Row="4" Margin="10,0,10,0"  x:Name ="clockGrid"  ClipToBounds="False" SizeChanged="clockGridSizeChanged" >
            <Canvas Margin="2" x:Name="cvTextClock" ClipToBounds="True">
                <Canvas x:Name="cvGraphicClock" ClipToBounds="True" />
            </Canvas>
        </Grid>

        <Grid Grid.Row="5" Margin="10,0,10,0"  x:Name ="dataGrid"  ClipToBounds="False" Background="Transparent" SizeChanged="dataGridSizeChanged" >
            <Canvas Margin="2" Name="cvTextData" ClipToBounds="True">
                <Canvas Name="cvGraphicData" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="dataMouseLBD" />
            </Canvas>
        </Grid>
        <StackPanel Grid.Row="6" Margin="10" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Margin="0,0,10,0" Content="Track Buffer" Width="100" Click="btTrackWindowClick" />
            <Button Margin="0,0,10,0"  Content="Sectors Buffer" Width="100" Click="btSectorWindowClick" />
            <Button Margin="0,0,10,0"  Content="Disk Layout" Width="100"  Click="btDiskLayoutClick"/>
            <Button Margin="0,0,10,0"  Content="Save Pict" Width="100"  Click="btSavePictClick"/>
            <Button Margin="0,0,10,0"  Content="Protections" Width="100" Click="btProtectionClick" />
            <Button Margin="0,0,10,0"  Content="Write Disk" Width="100"  Click="btWriteDiskClick"/>
        </StackPanel>
    </Grid>
</Window>
