<Window x:Class="Aufit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jlg="clr-namespace:Aufit"
        Height="{jlg:SettingBinding Height}"
        Width="{jlg:SettingBinding Width}"
        Left="{jlg:SettingBinding Left}"
        Top="{jlg:SettingBinding Top}" 
        Closing="mainWinClosing" AllowDrop="True" Drop="fileDrop">
    <Grid Name="mainGrid" KeyDown="keyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Name="gridCommand">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btFile" Content="Load image" Click="openFileClick" Height="20" VerticalAlignment="Top" Margin="5,5,0,0" />
            <Button Grid.Column="1" Content="Reload" Click="reloadClick" Height="20" VerticalAlignment="Top" Margin="5,5,0,0" />
            <TextBox Grid.Column="2" Name="tbFileName" BorderThickness="0" Background="Transparent" Margin="5,5,0,0" VerticalContentAlignment="Center"/>
            <TextBox Grid.Column="3" Name="tbRevolution" BorderThickness="0" Text="Rev. */*" Height="18" TextAlignment="Center" 
				HorizontalAlignment="Right" Background="Transparent" />
            <Button Grid.Column="4" Margin="5,0,0,0" Height="18" Width="18" BorderThickness="0" Background="{x:Null}" Click="minusRevClicked">
                <Image Source="Resources/minus.png"/>
            </Button>
            <Button Grid.Column="5" Margin="5,0,0,0" Height="18" Width="18" Click="plusRevClicked" BorderThickness="0" Background="{x:Null}" >
                <Image Source="Resources/plus.png"/>
            </Button>
            <CheckBox Grid.Column="6" x:Name="cbLimitFlux" Content="Limit Flux" Margin="15,0,10,0" VerticalAlignment="Center" 
				Click="cbLimitClick" HorizontalAlignment="Right" IsChecked="True" />
            <Button Grid.Column="7" Name="btSave" Height="20" Margin="0,5,5,0"  Content="Save Pict" Width="80"  Click="btSavePictClick"/>
        </Grid>

        <Grid Grid.Row="1" Name="matrixGrid" Margin="5" Loaded="matrixGridLoaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Canvas Grid.Column="0" Name="BM1" />
            <Canvas Grid.Column="1" Name="BM2" />
            <TabControl  Grid.Column="2" x:Name="tabCtrl" Background="Transparent" SelectionChanged="tabHistoInfoChanged">
                <TabItem Header="Histogram" Background="Transparent">
                    <Grid Margin="0,0,0,0" x:Name ="histoGrid"  ClipToBounds="True" Background="Transparent" SizeChanged="histoGridSizeChanged">
                        <Canvas Margin="2" Name="cvTextHisto" ClipToBounds="True" Background="Transparent">
                            <Canvas Name="cvGraphicHisto" ClipToBounds="True" Background="Transparent" />
                        </Canvas>
                        <CheckBox x:Name="cbHistoLog" Grid.Column="2" Content="Log Scale" Margin="0,15,15,0" VerticalAlignment="Top" 
                      Click="cbHistoLogClick" HorizontalAlignment="Right" />
                    </Grid>
                </TabItem>
                <TabItem Name="tabItemInfo" Header="Information" Background="Transparent">
                    <Grid>
                        <TextBox Name="infoBox" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
                   </Grid>
                </TabItem>
            </TabControl>
            <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="87*"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>
                <Button Name="btInfSave" Click="infoSaveClick" Content="Save" Width="60"  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Hidden"/>
                <Button Name="btInfClear" Click="infoClearClick" Content="Clear" Width="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,65,0" Visibility="Hidden"/>
            </Grid>

        </Grid>

        <Grid Grid.Row="2" Margin="5" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Name="progress" Visibility="Hidden" IsIndeterminate="True" Width="100"/>
            <TextBox Grid.Column="1" BorderThickness="0" Name="tbStatus" FontWeight="Bold" FontSize="14" Visibility="Visible" Margin="10,0,0,0" />
            <TextBox Grid.Column="2" Margin="10,0,0,0" Name="tbVersion" Text="Version" BorderThickness="0"  Background="Transparent" />
        </Grid>

        <TabControl  Grid.Row="2" x:Name="tabDisplay" Background="Transparent" Margin="5" SelectionChanged="tabDisplaySelectionChanged">
            <TabItem x:Name="tabItemTrack" Header="Track View" Background="Transparent"  Width="80" HorizontalAlignment="Left">
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="tbFluxInfo" FontFamily="Arial" FontSize="13" Foreground="DarkBlue" FontWeight="Bold" Width="auto" Height="18" BorderThickness="0" Background="Transparent"/>
                        <Ellipse Grid.Column="1" x:Name="redDot" Fill="Red" HorizontalAlignment="Left" Height="16" Stroke="Red" VerticalAlignment="Top" Width="16" Visibility="Hidden"/>
                        <CheckBox Grid.Column="2" x:Name="cbDetail" Content="Detail" Margin="5,0,5,0" VerticalAlignment="Center" Click="cbDetailClick"
							  HorizontalAlignment="Right" IsChecked="True" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,0,10,0"  x:Name ="fluxGrid"  ClipToBounds="False" Background="Transparent" SizeChanged="fluxGridSizeChanged" >
                        <Canvas Margin="2" Name="cvTextFlux" ClipToBounds="True" Grid.ColumnSpan="2">
                            <Canvas Name="cvGraphicFlux" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="fluxMouseLBD" MouseWheel="fluxMouseWheel" 
									MouseLeftButtonUp="fluxMouseLBU" MouseMove="fluxMouseMove" MouseRightButtonDown="fluxMouseRBDown"/>
                        </Canvas>
                        <StackPanel Grid.Column="5" Margin="10,20,15,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Grid.Column="8" x:Name="cbA1" Content="A1" Margin="5,0,5,0" VerticalAlignment="Top" 
								HorizontalAlignment="Right" IsChecked="True" />
                            <CheckBox Grid.Column="9" x:Name="cbC2" Content="C2" Margin="5,0,5,0" VerticalAlignment="Top" Click="cbDetailClick"
								HorizontalAlignment="Right" IsChecked="False" />
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    <Grid Grid.Row="2" Margin="10,0,10,0"  x:Name ="clockGrid"  ClipToBounds="False" SizeChanged="clockGridSizeChanged" >
                        <Canvas Margin="2" x:Name="cvTextClock" ClipToBounds="True">
                            <Canvas x:Name="cvGraphicClock" ClipToBounds="True" />
                        </Canvas>
                    </Grid>

                    <Grid Grid.Row="3" Margin="10,0,10,0"  x:Name ="dataGrid"  ClipToBounds="False" Background="Transparent" SizeChanged="dataGridSizeChanged" >
                        <Canvas Margin="2" Name="cvTextData" ClipToBounds="True">
                            <Canvas Name="cvGraphicData" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="dataMouseLBD" />
                        </Canvas>
                    </Grid>


                </Grid>
            </TabItem>

            <TabItem x:Name="tabItemDisk" Header="Disk View" Width="80">
                <Grid Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Name="gridImageView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"   Stretch="Uniform">
                                <Grid Name="cvDisk0" Margin="0" />
                            </Viewbox>
                            <Viewbox Grid.Column="1" Stretch="Uniform" >
                                <Grid Name="cvDisk1" Margin="0" />
                            </Viewbox>
                        </Grid>
                        <Grid Grid.Row="1" Background="Transparent" Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="tbImageName"  BorderThickness="0" Background="Transparent" FontFamily="Segoe UI" FontSize="12"/>
                            <TextBox Grid.Column="1" Name="tbImageVersion" BorderThickness="0" Background="Transparent" FontFamily="Segoe UI" FontSize="12"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>                            
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0" Text="Resolution: " BorderThickness="0" VerticalContentAlignment="Center" Background="Transparent"/>
                        <RadioButton Grid.Column="1" Name="rbHigh" Content="High" Margin="0,0,7,0" VerticalContentAlignment="Center"/>
                        <RadioButton Grid.Column="2" Name="rbMed" Content="Med" IsChecked="True"  Margin="0,0,7,0" VerticalContentAlignment="Center"/>
                        <RadioButton Grid.Column="3" Name="rbLow" Content="Low" Margin="0,0,7,0" VerticalContentAlignment="Center"/>
                        <CheckBox Grid.Column="4" x:Name="cbOutOfBand" Content="Out of Band" Margin="20,0,10,0" VerticalAlignment="Center" 
				            HorizontalAlignment="Right" IsChecked="True" Click="btDiskRedraw" />
                        <CheckBox Grid.Column="5" x:Name="cbDiskNFA" Content="Unf. NFA" Margin="15,0,10,0" VerticalAlignment="Center" 
				            HorizontalAlignment="Right" IsChecked="False" Click="btDiskRedraw"/>
                        <Button Grid.Column="6" Content="Save Picture" Width="80" Margin="0,2,0,0" VerticalContentAlignment="Center" Click="saveImageClick" HorizontalAlignment="Right"/>
                        <Button Grid.Column="7" Name="btDisk" Margin="5,2,0,0"  Content="Redraw" Width="80"  Click="btDiskRedraw" VerticalContentAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem x:Name="tabItemContent" Header="Data View" Width="80">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <FlowDocumentScrollViewer Margin="0" Grid.Row="0" ScrollViewer.VerticalScrollBarVisibility="Auto" Name="fdViewer" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Name="cbMFM" Content=" MFM"  HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Margin="0,0,5,0" Content="Save" Width="80" Click="bufferSaveClick" HorizontalAlignment="Right"/>
                        <Button Grid.Column="2" Margin="0,0,5,0" Content="Layout" Width="80" Click="btLayoutClick" />
                        <Button Grid.Column="3" Margin="0,0,5,0" Content="Track" Width="80" Click="btTrackClick" />
                        <Button Grid.Column="4" Margin="0,0,5,0" Content="Sectors" Width="80" Click="btSectorClick" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabItemAnalysis" Header="Analysis" Width="80">
                <Grid Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <TextBox BorderThickness="0" VerticalScrollBarVisibility="Auto" Margin="2" Name="tbAnalysis" FontFamily="Consolas" FontSize="15" />
                    </Grid>

                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Name="btAnaSave" Margin="0,0,5,0" Content="Save" Click="anaSaveClick" Width="80" HorizontalAlignment="Right"/>
                        <Button Grid.Column="1" Name="btProt" Margin="0,0,5,0"  Content="Protections" Click="btProtectionClick" Width="80" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabItemSave" Header="Save Image" Width="80">
                <Grid Margin="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <TextBox BorderThickness="0" VerticalScrollBarVisibility="Auto" Margin="5" Name="tbSaveImage" FontFamily="Consolas" FontSize="15" />
                    </Grid>

                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="Output Format:" VerticalContentAlignment="Center" Height="20" BorderThickness="0" IsTabStop="False" Focusable="False"/>
                        <ComboBox Grid.Column="1" Margin="5,0,0,0" Name="cbOutputFormat" Width="80" Height="20">
                            <ComboBoxItem IsSelected="True">STX</ComboBoxItem>
                            <ComboBoxItem Name="cbST"> ST</ComboBoxItem>
                            <ComboBoxItem Name="cbMSA">MSA</ComboBoxItem>
                        </ComboBox>
                        <CheckBox Grid.Column="2" x:Name="cbForceDS" Content="Force DS" Margin="5,0,0,0" VerticalAlignment="Center" 
							  HorizontalAlignment="Right" IsChecked="False" />
                        <CheckBox Grid.Column="3" x:Name="cbOptimize" Content="Optimize" Margin="5,0,0,0" VerticalAlignment="Center" 
							  HorizontalAlignment="Right" IsChecked="True" />
                        <CheckBox Grid.Column="4" x:Name="cbDebug" Content="Debug" Margin="5,0,0,0" VerticalAlignment="Center" 
							  HorizontalAlignment="Right" IsChecked="False" />
                        <CheckBox Grid.Column="5" x:Name="cbSync" Content="WriteSync" Margin="5,0,0,0" VerticalAlignment="Center" 
							  HorizontalAlignment="Right" IsChecked="False" />
                        <Button Grid.Column="6" Margin="0,0,5,0"  Content="Clear content" Width="80"  Click="btWriteClearClick" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Button Grid.Column="7" Margin="0,0,5,0"  Content="Save content" Width="80"  Click="btWriteSaveClick" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Button Grid.Column="8" Margin="0,0,5,0"  Content="Write Image" Width="80"  Click="btWriteDiskClick" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
