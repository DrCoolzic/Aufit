<Window x:Class="Aufit.DiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskWindow" Height="700" Width="1400">
        <Grid Margin="0" >
        <Grid Background="DarkSlateGray" Name="gridDisk">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Grid.ColumnSpan="2" Name="tbDisk" Width="auto" Height="20" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" Foreground="White" BorderBrush="Transparent" />
            <Viewbox Grid.Column="0"   Stretch="Uniform">
                <Grid Name="cvDisk0" Margin="0" />
            </Viewbox>
            <Viewbox Grid.Column="1" Stretch="Uniform" >
            <Grid Name="cvDisk1" Margin="0" />
        </Viewbox>
    </Grid>
    <Button Grid.Column="0" Content="Save picture" Click="saveImageClick" Height="20" Width="100" VerticalAlignment="bottom" HorizontalAlignment="Left"/>
    </Grid>
</Window>
