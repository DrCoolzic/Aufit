<Window x:Class="Aufit.DiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskWindow" Height="900" Width="900">
    <Grid Margin="0" Background="#FFA0A4B8">
        <TextBox Name="tbDisk" Width="250" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Viewbox Stretch="Uniform">
            <Grid Name="cvDisk" Margin="0" >
                <Line Stroke="White" X1="450" Y1="450" X2="450" Y2="900" />
            </Grid>
        </Viewbox>
    </Grid>
</Window>
