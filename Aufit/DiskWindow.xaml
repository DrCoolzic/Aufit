<Window x:Class="Aufit.DiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskWindow" Height="700" Width="1400">
        <Grid Margin="0" >
        <Grid Background="DarkSlateGray" Name="gridDisk">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Grid.ColumnSpan="2" Name="tbDisk" Width="auto" Height="20" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" Foreground="White" BorderBrush="Transparent" />
            <Viewbox Grid.Column="0"   Stretch="Uniform">
                <Grid Name="cvDisk0" Margin="0" />
            </Viewbox>
            <Viewbox Grid.Column="1" Stretch="Uniform" >
            <Grid Name="cvDisk1" Margin="0" />
        </Viewbox>
    </Grid>
        <StackPanel Grid.Column="0" VerticalAlignment="bottom" HorizontalAlignment="Left" Orientation="Horizontal">
            <Button Content="Save" Click="saveImageClick" Height="20" Width="50" Margin="0,0,10,0"/>
            <RadioButton Name="rbHigh" Content="High" Foreground="White" Margin="0,0,5,0"/>
            <RadioButton Name="rbMed" Content="Med" IsChecked="True"  Foreground="White" Margin="0,0,5,0"/>
            <RadioButton Name="rbLow" Content="Low" Foreground="White" Margin="0,0,5,0"/>
        </StackPanel>
    </Grid>
</Window>
